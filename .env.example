# Copy to .env and adjust. Every value has a default, so .env is optional.

# --- Server -----------------------------------------------------------------
POSTGRES_VERSION=17
POSTGRES_PORT=5432
# Admin login (used by the loader). Local-only defaults: change them if the port is reachable by others.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Read-only login for everyone else.
READER_USER=reader
READER_PASSWORD=reader

# --- Data size --------------------------------------------------------------
# Scale factor per benchmark: a number (0.01, 0.1, 1, 3, 10, ...) or a preset:
#   tiny = 0.01   small = 0.1   standard = 1   large = 10
TPCH_SCALE=1
TPCDS_SCALE=1
# Set PRESET to override both scales at once.
PRESET=
# true: name databases by scale (tpch_sf1, tpch_sf10, ...) so several sizes can coexist.
KEEP_SCALES=false
# Scale factors above 10 need FORCE=1.
FORCE=

# --- Loader -----------------------------------------------------------------
# DuckDB memory cap while generating; it spills to disk beyond this.
LOADER_MEMORY_LIMIT=4GB
# Empty = all CPUs.
LOADER_THREADS=
# Per-query timeout in seconds for `make verify`.
QUERY_TIMEOUT=300

# --- PostgreSQL tuning (laptop-sized defaults) ------------------------------
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=1GB
PG_PARALLEL_WORKERS=4
